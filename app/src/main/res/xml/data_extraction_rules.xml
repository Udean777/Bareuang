<?xml version="1.0" encoding="utf-8"?><!--
   Backup / transfer rules for devices on API 31+.
   The Room database is excluded from cloud backup and device-to-device
   migration. The legacy session preference exclusion is retained for upgrades.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="bareuang_offline.db" />
        <exclude domain="database" path="bareuang_offline.db-wal" />
        <exclude domain="database" path="bareuang_offline.db-shm" />
        <exclude domain="sharedpref" path="bareuang_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="bareuang_offline.db" />
        <exclude domain="database" path="bareuang_offline.db-wal" />
        <exclude domain="database" path="bareuang_offline.db-shm" />
        <exclude domain="sharedpref" path="bareuang_session.xml" />
    </device-transfer>
</data-extraction-rules>
