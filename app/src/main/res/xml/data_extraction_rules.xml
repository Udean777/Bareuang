<?xml version="1.0" encoding="utf-8"?><!--
   Backup / transfer rules for devices on API 31+.
   Financial data (Room DB) and session identity (uid/email) are excluded from
   both cloud backup and device-to-device migration; harmless preferences
   (theme, tour, onboarding) remain included.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="bare_budget_offline.db" />
        <exclude domain="database" path="bare_budget_offline.db-wal" />
        <exclude domain="database" path="bare_budget_offline.db-shm" />
        <exclude domain="sharedpref" path="bare_budget_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="bare_budget_offline.db" />
        <exclude domain="database" path="bare_budget_offline.db-wal" />
        <exclude domain="database" path="bare_budget_offline.db-shm" />
        <exclude domain="sharedpref" path="bare_budget_session.xml" />
    </device-transfer>
</data-extraction-rules>