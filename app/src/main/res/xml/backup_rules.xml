<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices on API 30 and below.
   Financial data (Room DB) and session identity (uid/email) never leave the
   device via backup; harmless preferences (theme, tour, onboarding) do.
-->
<full-backup-content>
    <exclude domain="database" path="bare_budget_offline.db" />
    <exclude domain="database" path="bare_budget_offline.db-wal" />
    <exclude domain="database" path="bare_budget_offline.db-shm" />
    <exclude domain="sharedpref" path="bare_budget_session.xml" />
</full-backup-content>