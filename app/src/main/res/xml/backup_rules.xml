<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices on API 30 and below.
   The Room database is excluded so financial records are not copied by Android
   backup. The legacy session preference exclusion is retained for upgrades.
-->
<full-backup-content>
    <exclude domain="database" path="bareuang_offline.db" />
    <exclude domain="database" path="bareuang_offline.db-wal" />
    <exclude domain="database" path="bareuang_offline.db-shm" />
    <exclude domain="sharedpref" path="bareuang_session.xml" />
</full-backup-content>
