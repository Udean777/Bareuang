# Copy to .env.local for `vercel dev` (web/.env.local, not committed)
# Get key at https://aistudio.google.com → Create API key
GEMINI_API_KEY=AIza...
# Required for production: Vercel KV/Upstash REST endpoint and bearer token.
KV_REST_API_URL=https://<your-kv-endpoint>
KV_REST_API_TOKEN=<your-kv-token>
# Optional limits (per UTC day)
RATE_LIMIT_RPD=20
RATE_LIMIT_IP_RPD=60
GLOBAL_LIMIT_RPD=5000
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=https://bareuang.app
